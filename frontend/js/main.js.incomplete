const API_URL = 'http://localhost:5005/api';
let allCounties = [];
let compareList = [];

window.onload = () => {
    loadStates();
    setupGlobalSearch();
};

function loadStates() {
    fetch(`${API_URL}/states`)
        .then(res => res.json())
        .then(result => {
            const select = document.getElementById('stateSelect');
            if (!select) return;
            select.innerHTML = '<option value="">-- Select State --</option>';
            result.data.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.state;
                opt.textContent = `${item.state} (${item.county_count})`;
                select.appendChild(opt);
            });
        });
}

function setupGlobalSearch() {
    const input = document.getElementById('globalSearchInput');
    if (!input) return;
    let timeout;
    input.addEventListener('input', function() {
        clearTimeout(timeout);
        const query = this.value.trim();
        if (query.length < 2) {
            document.getElementById('searchResults').style.display = 'none';
            return;
        }
        timeout = setTimeout(() => {
            fetch(`${API_URL}/search?q=${encodeURIComponent(query)}`)
                .then(res => res.json())
                .then(result => displaySearchResults(result.data));
        }, 300);
    });
}

function displaySearchResults(counties) {
    const container = document.getElementById('searchResults');
    if (!counties || counties.length === 0) {
        container.innerHTML = '<div class="search-item">No results</div>';
        container.style.display = 'block';
        return;
    }
    
    let html = '';
    counties.forEach(c => {
        const isAdded = compareList.some(item => item.fips === c.fips);
        html += `<div class="search-item ${isAdded ? 'added' : ''}" onclick="${isAdded ? '' : `addToCompare(${c.fips}, '${c.county_name}', '${c.state_name}', ${c.median_income}, ${c.diabetes_adjprev}, ${c.obesity_adjprev}, ${c.bphigh_adjprev})`}">
            <div class="search-item-main">
                <span class="search-county">${c.county_name}</span>
                <span class="search-state">${c.state_name}</span>
            </div>
            <div class="search-item-stats">
                <span>$${Number(c.median_income).toLocaleString()}</span>
                <span>D:${c.diabetes_adjprev}% O:${c.obesity_adjprev}%</span>
                <span class="search-add">${isAdded ? '✓ Added' : '+ Add'}</span>
            </div>
        </div>`;
    });
    container.innerHTML = html;
    container.style.display = 'block';
}

function addToCompare(fips, county, state, income, diabetes, obesity, bphigh) {
    if (compareList.some(c => c.fips === fips)) return;
    if (compareList.length >= 8) {
        alert('Max 8 counties');
        return;
    }
    compareList.push({ fips, county_name: county, state_name: state, median_income: income, diabetes_adjprev: diabetes, obesity_adjprev: obesity, bphigh_adjprev: bphigh });
    updateComparePanel();
}

function removeFromCompare(fips) {
    compareList = compareList.filter(c => c.fips !== fips);
    updateComparePanel();
}

function updateComparePanel() {
    const panel = document.getElementById('comparePanel');
    if (!panel) return;
    if (compareList.length === 0) {
        panel.style.display = 'none';
        return;
    }
    let html = '<h3>Compare Counties</h3><div class="compare-tags">';
    compareList.forEach(c => {
        html += `<div class="compare-tag"><span>${c.county_name}, ${c.state_name}</span><button onclick="removeFromCompare(${c.fips})">&times;</button></div>`;
    });
    html += '</div>';
    if (compareList.length >= 2) {
        html += '<button class="compare-btn" onclick="runComparison()">Compare Now</button>';
    }
    panel.innerHTML = html;
    panel.style.display = 'block';
}

function runComparison() {
    if (compareList.length < 2) return;
    const fips = compareList.map(c => c.fips).join(',');
    fetch(`${API_URL}/compare?fips=${fips}`)
        .then(res => res.json())
        .then(result => displayComparisonTable(result.data));
}

function displayComparisonTable(counties) {
    const metrics = ['diabetes_adjprev', 'obesity_adjprev', 'bphigh_adjprev', 'depression_adjprev', 'stroke_adjprev', 'copd_adjprev'];
    
    let html = '<h2>Health Metrics Comparison</h2><table class="comparison-table"><thead><tr><th>County</th><th>Income</th>';
    metrics.forEach(m => {
        const label = m.replace('_adjprev', '').toUpperCase();
        html += `<th>${label}</th>`;
    });
    html += '</tr></thead><tbody>';
    
    counties.forEach(c => {
        html += `<tr><td><strong>${c.county_name}, ${c.state_name}</strong></td><td>$${Number(c.median_income).toLocaleString()}</td>`;
        metrics.forEach(m => {
            const val = c[m];
            const color = val < 20 ? '#27ae60' : val < 35 ? '#f39c12' : '#e74c3c';
            html += `<td style="color:${color}; font-weight:bold;">${val ? val.toFixed(1) : 'N/A'}%</td>`;
        });
        html += '</tr>';
    });
    
    html += '</tbody></table>';
    document.getElementById('results').innerHTML = html;
}

function loadByState() {
    const state = document.getElementById('stateSelect').value;
    if (!state) { alert('Select a state'); return; }
    fetch(`${API_URL}/counties?state=${encodeURIComponent(state)}`)
        .then(res => res.json())
        .then(result => displayCountiesTable(result.data));
}

function displayCountiesTable(counties) {
    let html = '<table class="counties-table"><thead><tr><th>County</th><th>State</th><th>Income</th><th>Diabetes</th><th>Obesity</th><th>High BP</th></tr></thead><tbody>';
    counties.forEach(c => {
        html += `<tr><td>${c.county_name}</td><td>${c.state_name}</td><td>$${Number(c.median_income).toLocaleString()}</td><td>${c.diabetes_adjprev}%</td><td>${c.obesity_adjprev}%</td><td>${c.bphigh_adjprev}%</td></tr>`;
    });
    html += '</tbody></table>';
    document.getElementById('results').innerHTML = html;
}
