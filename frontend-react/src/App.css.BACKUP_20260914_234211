@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Inter', -apple-system, sans-serif;
  background: #0a0e17;
  color: #e2e8f0;
}

.app-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0a0e17;
}

/* ═══════════════════════════════════════
   HEADER - Like HF RiskAI
   ═══════════════════════════════════════ */
.app-header {
  background: linear-gradient(135deg, #0a0e17 0%, #1a1f3a 50%, #0a0e17 100%);
  color: white;
  padding: 4rem 2rem;
  text-align: center;
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid rgba(99, 102, 241, 0.3);
}

.app-header::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 50% 50%, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
}

.header-content { position: relative; z-index: 1; }

.app-title {
  font-size: 3rem;
  font-weight: 800;
  margin-bottom: 0.75rem;
  background: linear-gradient(135deg, #10b981, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.app-subtitle {
  font-size: 1.1rem;
  color: #94a3b8;
  font-weight: 300;
  margin-bottom: 2rem;
}

/* Hero Stats - Like HF RiskAI */
.hero-stats {
  display: flex;
  justify-content: center;
  gap: 4rem;
  margin: 2rem 0;
}

.hero-stat .hero-number {
  font-size: 2.5rem;
  font-weight: 800;
  color: #10b981;
}

.hero-stat .hero-label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: #64748b;
  margin-top: 0.25rem;
}

/* Launch Button */
.btn-launch {
  display: inline-block;
  margin-top: 1.5rem;
  padding: 1rem 3rem;
  background: linear-gradient(135deg, #10b981, #06b6d4);
  color: white;
  border: none;
  border-radius: 50px;
  font-size: 1.1rem;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: all 0.3s;
  text-transform: uppercase;
}

.btn-launch:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 40px rgba(16, 185, 129, 0.3);
}

/* ═══════════════════════════════════════
   PROBLEM SECTION - Like HF RiskAI
   ═══════════════════════════════════════ */
.problem-section {
  padding: 4rem 2rem;
  text-align: center;
  background: #0f1320;
}

.section-title {
  font-size: 2rem;
  font-weight: 700;
  color: #10b981;
  margin-bottom: 0.75rem;
}

.section-subtitle {
  color: #94a3b8;
  font-size: 1.1rem;
  margin-bottom: 2.5rem;
}

.problem-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.problem-card {
  background: #1a1f3a;
  border: 1px solid #2d3748;
  border-radius: 12px;
  padding: 2.5rem 2rem;
  text-align: center;
  transition: all 0.3s;
}

.problem-card:hover {
  border-color: #10b981;
  transform: translateY(-4px);
}

.problem-icon { font-size: 2.5rem; margin-bottom: 1rem; }

.problem-number {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.problem-card:nth-child(1) .problem-number { color: #ef4444; }
.problem-card:nth-child(2) .problem-number { color: #f59e0b; }
.problem-card:nth-child(3) .problem-number { color: #10b981; }

.problem-desc { color: #94a3b8; font-size: 0.95rem; }
.problem-source { color: #475569; font-size: 0.8rem; margin-top: 0.5rem; }

/* ═══════════════════════════════════════
   ERROR BANNER
   ═══════════════════════════════════════ */
.error-banner {
  background: linear-gradient(135deg, #7f1d1d, #991b1b);
  color: white;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-retry, .btn-dismiss {
  background: rgba(255,255,255,0.2);
  color: white;
  border: none;
  padding: 0.5rem 1rem;
  border-radius: 4px;
  cursor: pointer;
}

/* ═══════════════════════════════════════
   DASHBOARD SECTION
   ═══════════════════════════════════════ */
.dashboard-section {
  padding: 2rem;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

/* Controls */
.controls {
  background: #1a1f3a;
  padding: 1.5rem;
  border-radius: 12px;
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
  border: 1px solid #2d3748;
}

.global-search {
  display: flex;
  gap: 0.5rem;
  flex: 1;
  min-width: 300px;
}

.search-input-global {
  flex: 1;
  padding: 0.75rem 1rem;
  border: 1px solid #2d3748;
  border-radius: 8px;
  background: #0a0e17;
  color: white;
  font-size: 1rem;
}

.search-input-global:focus {
  outline: none;
  border-color: #10b981;
}

.state-select {
  padding: 0.75rem 1rem;
  border: 1px solid #2d3748;
  border-radius: 8px;
  background: #0a0e17;
  color: white;
  font-size: 1rem;
  cursor: pointer;
}

.state-select:focus { outline: none; border-color: #10b981; }

.btn-action {
  padding: 0.75rem 1.5rem;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s;
}

.btn-action:hover { transform: translateY(-1px); }
.btn-action:disabled { opacity: 0.4; cursor: not-allowed; }

.btn-blue { background: #3b82f6; }
.btn-green { background: #10b981; }
.btn-red { background: #ef4444; }
.btn-orange { background: #f59e0b; }
.btn-purple { background: #8b5cf6; }
.btn-teal { background: #14b8a6; }

/* Compare bar */
.compare-bar {
  background: linear-gradient(135deg, #1e40af, #3b82f6);
  color: white;
  padding: 1rem 2rem;
  border-radius: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
  margin-bottom: 1rem;
}

/* ═══════════════════════════════════════
   TABS
   ═══════════════════════════════════════ */
.tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.tab {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
  color: white;
  background: #2d3748;
  transition: all 0.3s;
}

.tab.active {
  box-shadow: 0 4px 15px rgba(0,0,0,0.3);
  transform: translateY(-2px);
}

/* ═══════════════════════════════════════
   TAB CONTENT
   ═══════════════════════════════════════ */
.tab-content {
  background: #1a1f3a;
  border-radius: 12px;
  padding: 2rem;
  border: 1px solid #2d3748;
  min-height: 400px;
}

.tab-content h2 {
  color: #10b981;
  margin-bottom: 1.5rem;
  font-size: 1.5rem;
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.stat-box {
  padding: 1.5rem;
  border-radius: 12px;
  text-align: center;
  color: white;
  font-weight: 600;
  border: 1px solid rgba(255,255,255,0.1);
}

.stat-number {
  font-size: 2rem;
  font-weight: 800;
  margin-top: 0.5rem;
}

/* Search input */
.search-input {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid #2d3748;
  border-radius: 8px;
  background: #0a0e17;
  color: white;
  font-size: 1rem;
  margin-bottom: 1.5rem;
}

.search-input:focus { outline: none; border-color: #10b981; }

/* Data Table */
.data-table {
  width: 100%;
  border-collapse: collapse;
  border-radius: 8px;
  overflow: hidden;
}

.data-table th {
  background: #0f1320;
  color: #10b981;
  padding: 14px 12px;
  text-align: left;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 2px solid #2d3748;
}

.data-table td {
  padding: 12px;
  border-bottom: 1px solid #1e293b;
  font-size: 0.9rem;
  color: #e2e8f0;
}

.data-table tr:hover { background: rgba(16, 185, 129, 0.05); }

.data-table input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
  accent-color: #10b981;
}

/* Statistics Detail */
.stats-detail-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.stats-detail-card {
  background: #0f1320;
  border-radius: 12px;
  padding: 1.5rem;
  border: 1px solid #2d3748;
}

.stats-detail-card h3 {
  color: #10b981;
  margin-bottom: 1rem;
  font-size: 1rem;
  text-transform: capitalize;
}

.mini-table { width: 100%; }
.mini-table td {
  padding: 8px 0;
  border-bottom: 1px solid #1e293b;
  color: #94a3b8;
}
.mini-table td:last-child { color: #10b981; font-weight: 600; text-align: right; }

/* Correlation */
.correlation-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.correlation-card {
  background: #0f1320;
  border-radius: 12px;
  padding: 2rem;
  border: 1px solid #2d3748;
  text-align: center;
}

.correlation-card h4 {
  text-transform: capitalize;
  color: #94a3b8;
  margin-bottom: 0.5rem;
}

.correlation-value { font-size: 2.5rem; font-weight: 800; }

.correlation-bar-container {
  height: 8px;
  background: #1e293b;
  border-radius: 4px;
  overflow: hidden;
  margin: 1rem 0;
}

.correlation-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #10b981, #ef4444);
  transition: width 0.5s;
}

.correlation-card small { color: #475569; }

/* Equity */
.equity-result {
  background: #0f1320;
  border-radius: 12px;
  padding: 3rem;
  margin-top: 1.5rem;
  text-align: center;
  border: 1px solid #2d3748;
}

.equity-score { font-size: 4rem; font-weight: 800; }
.equity-label { font-size: 1.3rem; margin: 0.5rem 0; color: #94a3b8; }
.equity-details {
  display: flex;
  gap: 3rem;
  justify-content: center;
  margin-top: 1.5rem;
  color: #64748b;
}

/* AI */
.ai-result {
  background: #0f1320;
  border-radius: 12px;
  padding: 2rem;
  margin-top: 1.5rem;
  border: 1px solid #2d3748;
  line-height: 1.8;
  color: #cbd5e1;
}

/* ═══════════════════════════════════════
   REFERENCES - Like HF RiskAI
   ═══════════════════════════════════════ */
.references-section {
  padding: 4rem 2rem;
  background: #0f1320;
  border-top: 1px solid #1e293b;
}

.references-section h2 {
  text-align: center;
  color: #10b981;
  font-size: 1.8rem;
  margin-bottom: 2rem;
}

.ref-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

.ref-card {
  background: #1a1f3a;
  border: 1px solid #2d3748;
  border-radius: 12px;
  padding: 1.5rem;
  transition: all 0.3s;
}

.ref-card:hover { border-color: #10b981; }
.ref-card h4 { color: #e2e8f0; margin-bottom: 0.5rem; }
.ref-card p { color: #64748b; font-size: 0.9rem; }

/* ═══════════════════════════════════════
   FOOTER
   ═══════════════════════════════════════ */
.app-footer {
  background: #050810;
  color: #475569;
  text-align: center;
  padding: 2rem;
  font-size: 0.85rem;
  border-top: 1px solid #1e293b;
  margin-top: auto;
}

/* ═══════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════ */
@media (max-width: 768px) {
  .app-title { font-size: 2rem; }
  .hero-stats { flex-direction: column; gap: 1.5rem; }
  .problem-cards { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .controls { flex-direction: column; }
  .tabs { overflow-x: auto; }
}

/* ═══════════════════════════════════════
   COMPARISON PANEL
   ═══════════════════════════════════════ */
.comparison-panel {
  background: #0f1320;
  border: 2px solid #10b981;
  border-radius: 12px;
  padding: 2rem;
  margin-bottom: 2rem;
}

.comparison-panel h3 {
  color: #10b981;
  font-size: 1.3rem;
  margin-bottom: 1.5rem;
  text-align: center;
}

.comparison-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: start;
}

.comparison-table-wrapper {
  overflow: auto;
}

.comparison-chart {
  background: #1a1f3a;
  border-radius: 12px;
  padding: 1rem;
  border: 1px solid #2d3748;
}

@media (max-width: 1024px) {
  .comparison-grid {
    grid-template-columns: 1fr;
  }
}
