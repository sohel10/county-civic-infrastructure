from flask import Flask, jsonify, request
from flask_cors import CORS
import sqlite3

app = Flask(__name__)
CORS(app)

DB = 'counties.db'

def get_db():
    conn = sqlite3.connect(DB)
    conn.row_factory = sqlite3.Row
    return conn

@app.route('/api/states')
def get_states():
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute('SELECT DISTINCT state, COUNT(*) as county_count FROM counties GROUP BY state ORDER BY state')
    states = [{'state': row['state'], 'county_count': row['county_count']} for row in cursor.fetchall()]
    conn.close()
    return jsonify({'data': states})

@app.route('/api/counties/by-state')
def get_counties_by_state():
    state = request.args.get('state')
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute('SELECT fips, county, state, poverty_pct, diabetes, obesity, bphigh, depression FROM counties WHERE state = ? ORDER BY county', (state,))
    cols = [description[0] for description in cursor.description]
    data = [dict(zip(cols, row)) for row in cursor.fetchall()]
    conn.close()
    return jsonify({'data': data})

@app.route('/api/search')
def search():
    q = request.args.get('q', '').lower()
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute('SELECT * FROM counties WHERE LOWER(county) LIKE ? OR LOWER(state) LIKE ? LIMIT 50', (f'%{q}%', f'%{q}%'))
    cols = [description[0] for description in cursor.description]
    data = [dict(zip(cols, row)) for row in cursor.fetchall()]
    conn.close()
    return jsonify({'data': data})

@app.route('/api/statistics')
def get_statistics():
    state = request.args.get('state')
    conn = get_db()
    cursor = conn.cursor()
    if state:
        cursor.execute('SELECT AVG(poverty_pct) as avg_poverty, AVG(diabetes) as avg_diabetes, AVG(obesity) as avg_obesity, AVG(bphigh) as avg_bphigh, AVG(depression) as avg_depression, COUNT(*) as total FROM counties WHERE state = ?', (state,))
    else:
        cursor.execute('SELECT AVG(poverty_pct) as avg_poverty, AVG(diabetes) as avg_diabetes, AVG(obesity) as avg_obesity, AVG(bphigh) as avg_bphigh, AVG(depression) as avg_depression, COUNT(*) as total FROM counties')
    row = cursor.fetchone()
    conn.close()
    return jsonify(dict(row))

@app.route('/api/correlation')
def get_correlation():
    state = request.args.get('state')
    from scipy.stats import pearsonr
    conn = get_db()
    cursor = conn.cursor()
    if state:
        cursor.execute('SELECT poverty_pct, diabetes, obesity FROM counties WHERE state = ?', (state,))
    else:
        cursor.execute('SELECT poverty_pct, diabetes, obesity FROM counties')
    rows = cursor.fetchall()
    conn.close()
    
    if len(rows) < 2:
        return jsonify({'error': 'Not enough data'}), 400
    
    poverty = [row['poverty_pct'] for row in rows]
    diabetes = [row['diabetes'] for row in rows]
    obesity = [row['obesity'] for row in rows]
    
    corr_pd, p_pd = pearsonr(poverty, diabetes)
    corr_po, p_po = pearsonr(poverty, obesity)
    corr_do, p_do = pearsonr(diabetes, obesity)
    
    return jsonify({
        'poverty_diabetes': {'r': round(corr_pd, 3), 'p_value': round(p_pd, 4)},
        'poverty_obesity': {'r': round(corr_po, 3), 'p_value': round(p_po, 4)},
        'diabetes_obesity': {'r': round(corr_do, 3), 'p_value': round(p_do, 4)}
    })

@app.route('/api/rankings')
def get_rankings():
    state = request.args.get('state')
    metric = request.args.get('metric', 'poverty_pct')
    conn = get_db()
    cursor = conn.cursor()
    if state:
        cursor.execute(f'SELECT * FROM counties WHERE state = ? ORDER BY {metric} DESC LIMIT 20', (state,))
    else:
        cursor.execute(f'SELECT * FROM counties ORDER BY {metric} DESC LIMIT 20')
    cols = [description[0] for description in cursor.description]
    data = [dict(zip(cols, row)) for row in cursor.fetchall()]
    conn.close()
    return jsonify({'data': data})

@app.route('/api/equity-index')
def equity_index():
    fips_list = request.args.get('fips', '').split(',')
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute('SELECT * FROM counties WHERE fips IN ({})'.format(','.join(['?' for _ in fips_list])), fips_list)
    cols = [description[0] for description in cursor.description]
    data = [dict(zip(cols, row)) for row in cursor.fetchall()]
    conn.close()
    
    if len(data) < 2:
        return jsonify({'error': 'Need 2 counties'}), 400
    
    c1, c2 = data[0], data[1]
    poverty_gap = abs(c1['poverty_pct'] - c2['poverty_pct'])
    diabetes_gap = abs(c1['diabetes'] - c2['diabetes'])
    obesity_gap = abs(c1['obesity'] - c2['obesity'])
    
    equity_score = (poverty_gap + diabetes_gap + obesity_gap) / 3
    
    return jsonify({
        'county1': c1['county'],
        'county2': c2['county'],
        'poverty_gap': round(poverty_gap, 1),
        'diabetes_gap': round(diabetes_gap, 1),
        'obesity_gap': round(obesity_gap, 1),
        'equity_score': round(equity_score, 1),
        'interpretation': 'High disparity' if equity_score > 10 else 'Moderate' if equity_score > 5 else 'Low'
    })

@app.route('/api/ai-suggestions', methods=['POST'])
def ai_suggestions():
    data = request.json
    counties = data.get('counties', [])
    if len(counties) < 2:
        return jsonify({'suggestions': 'Select 2 counties'}), 400
    
    c1, c2 = counties[0], counties[1]
    suggestions = f"""
HEALTH EQUITY ANALYSIS: {c1['county']}, {c1['state']} vs {c2['county']}, {c2['state']}

POVERTY DISPARITY:
- {c1['county']}: {c1['poverty_pct']}% poverty
- {c2['county']}: {c2['poverty_pct']}% poverty
- Gap: {abs(c1['poverty_pct'] - c2['poverty_pct']):.1f}%

DIABETES RATES:
- {c1['county']}: {c1['diabetes']}%
- {c2['county']}: {c2['diabetes']}%
- Gap: {abs(c1['diabetes'] - c2['diabetes']):.1f}%

OBESITY RATES:
- {c1['county']}: {c1['obesity']}%
- {c2['county']}: {c2['obesity']}%
- Gap: {abs(c1['obesity'] - c2['obesity']):.1f}%

RECOMMENDATIONS:
1. Focus on poverty reduction initiatives
2. Expand healthcare access in high-poverty areas
3. Community health programs
4. Chronic disease prevention
"""
    return jsonify({'suggestions': suggestions})

